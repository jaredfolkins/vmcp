// Host command cases for the fake host of hostinstall_test.go. Paths of
// files are under the host root; paths of cgroups are under the cgroup
// root.
{
  "install_id": "live-gate",
  // A host with resources of install live-gate from this and from older
  // vmcp versions, resources of another install, and untagged look-alikes.
  "teardown": {
    "cgroups": [
      {"path": "vmcp-live-gate", "owner": "live-gate"},
      // A machine cgroup with a live process: teardown kills it.
      {"path": "vmcp-live-gate/vmcp-0123456789", "procs": "4242\n"},
      // An older layout, deeper in the tree.
      {"path": "vmcp-live-gate/older/deeper"},
      {"path": "system.slice/vmcp-old-parent", "owner": "live-gate"},
      {"path": "system.slice/vmcp-old-parent/vmcp-9876543210"},
      {"path": "system.slice/docker-0123.scope"},
      {"path": "vmcp-other-site", "owner": "other-site"},
      {"path": "vmcp-other-site/vmcp-aaaaaaaaaa", "procs": "77\n"},
      {"path": "vmcp-lookalike"},
      {"path": "user.slice"},
    ],
    "files": {
      "etc/apparmor.d/vmcp-live-gate": "# vmcp-owner: live-gate\nprofile vmcp-live-gate {}\n",
      "etc/apparmor.d/vmcp-live-gate-v0": "# vmcp-owner: live-gate\nprofile vmcp-live-gate-v0 {}\n",
      "etc/apparmor.d/vmcp-foreign": "profile vmcp-foreign {}\n",
      "etc/apparmor.d/vmcp-other-site": "# vmcp-owner: other-site\nprofile vmcp-other-site {}\n",
      "etc/apparmor.d/usr.bin.example": "profile example {}\n",
      // An owner line that is not the first line is not a tag.
      "etc/apparmor.d/vmcp-late-tag": "profile vmcp-late-tag {}\n# vmcp-owner: live-gate\n",
      "etc/modules-load.d/vmcp-live-gate.conf": "# vmcp-owner: live-gate\nkvm\nkvm_intel\ntun\n",
      "etc/modules-load.d/vmcp-old-name.conf": "# vmcp-owner: live-gate\ntun\n",
      "etc/modules-load.d/modules.conf": "loop\n",
      "etc/tmpfiles.d/vmcp-live-gate.conf": "# vmcp-owner: live-gate\nd /sys/fs/cgroup/vmcp-live-gate 0755 root root - -\n",
      // An older name of the same install.
      "etc/tmpfiles.d/vmcp-cgroup-v0.conf": "# vmcp-owner: live-gate\nd /sys/fs/cgroup/vmcp-live-gate 0755 65532 65532 - -\n",
      "etc/tmpfiles.d/vmcp-other-site.conf": "# vmcp-owner: other-site\nd /sys/fs/cgroup/vmcp-other-site 0755 root root - -\n",
      // An untagged look-alike: teardown reports it and keeps it.
      "etc/tmpfiles.d/vmcp-lookalike.conf": "d /sys/fs/cgroup/vmcp-lookalike 0755 root root - -\n",
      "etc/tmpfiles.d/example.conf": "d /run/example 0755 root root - -\n",
      "etc/vmcp/live-gate/.vmcp-owner": "# vmcp-owner: live-gate\nseccomp.json\nreceipt.json\n",
      "etc/vmcp/live-gate/seccomp.json": "{}\n",
      "etc/vmcp/live-gate-old/.vmcp-owner": "# vmcp-owner: live-gate\nseccomp.json\n",
      "etc/vmcp/live-gate-old/seccomp.json": "{}\n",
      "etc/vmcp/other-site/.vmcp-owner": "# vmcp-owner: other-site\nseccomp.json\n",
      "etc/vmcp/other-site/seccomp.json": "{}\n",
    },
    // vmcp-live-gate//jail has no file: it goes with its parent.
    "loaded_profiles": {
      "vmcp-live-gate": "enforce",
      "vmcp-live-gate-v0": "complain",
      "vmcp-other-site": "enforce",
      "vmcp-foreign": "enforce",
      "docker-default": "enforce",
    },
    "links": [
      {"ifname": "vmcp-11111111", "ifalias": "vmcp:live-gate:m-1111111111111111"},
      {"ifname": "vmcp-22222222", "ifalias": "vmcp:other-site:m-2222222222222222"},
      {"ifname": "vmcp-33333333", "ifalias": ""},
      {"ifname": "eth0", "ifalias": ""},
    ],
    // Tables of the host network namespace, from a vmcp that ran there.
    "nft_tables": [
      {"family": "inet", "name": "vmcp", "comment": "vmcp:live-gate"},
      // An older name of the same install.
      {"family": "inet", "name": "vmcp-old", "comment": "vmcp:live-gate"},
      {"family": "inet", "name": "vmcp-other", "comment": "vmcp:other-site"},
      // A table of an older version without an install tag: reported, kept.
      {"family": "inet", "name": "vmcp-untagged", "comment": "vmcp owned"},
      {"family": "ip", "name": "filter", "comment": ""},
    ],
    "want_removed": [
      "link vmcp-11111111",
      "nft-table inet vmcp",
      "nft-table inet vmcp-old",
      "cgroup vmcp-live-gate",
      "cgroup system.slice/vmcp-old-parent",
      "apparmor-profile vmcp-live-gate",
      "apparmor-file /etc/apparmor.d/vmcp-live-gate",
      "apparmor-profile vmcp-live-gate-v0",
      "apparmor-file /etc/apparmor.d/vmcp-live-gate-v0",
      "modules-load /etc/modules-load.d/vmcp-live-gate.conf",
      "modules-load /etc/modules-load.d/vmcp-old-name.conf",
      "tmpfiles /etc/tmpfiles.d/vmcp-live-gate.conf",
      "tmpfiles /etc/tmpfiles.d/vmcp-cgroup-v0.conf",
      "config-file /etc/vmcp/live-gate/seccomp.json",
      "config-dir /etc/vmcp/live-gate",
      "config-file /etc/vmcp/live-gate-old/seccomp.json",
      "config-dir /etc/vmcp/live-gate-old",
    ],
    "want_killed_processes": 1,
    "want_conflicts": [
      "nft-table inet vmcp-untagged",
      "cgroup vmcp-lookalike",
      "apparmor-file /etc/apparmor.d/vmcp-foreign",
      "apparmor-file /etc/apparmor.d/vmcp-late-tag",
      "tmpfiles /etc/tmpfiles.d/vmcp-lookalike.conf",
      "link vmcp-33333333",
    ],
    "want_other_installs": [
      "cgroup vmcp-other-site",
      "apparmor-file /etc/apparmor.d/vmcp-other-site",
      "config-dir /etc/vmcp/other-site",
      "tmpfiles /etc/tmpfiles.d/vmcp-other-site.conf",
      "link vmcp-22222222",
      "nft-table inet vmcp-other",
    ],
    "want_kept_profiles": ["vmcp-other-site", "vmcp-foreign", "docker-default"],
  },
  // The vmcp service of the install runs: it holds the lock of its parent
  // cgroup, which has no machine and no process. Install and teardown
  // refuse and change nothing; status reports the running service.
  "service_running": {
    "cgroups": [{"path": "vmcp-live-gate", "owner": "live-gate", "locked": true}],
    "files": {
      "etc/apparmor.d/vmcp-live-gate": "# vmcp-owner: live-gate\nprofile vmcp-live-gate {}\n",
      "etc/modules-load.d/vmcp-live-gate.conf": "# vmcp-owner: live-gate\nkvm\nkvm_intel\ntun\n",
      "etc/vmcp/live-gate/.vmcp-owner": "# vmcp-owner: live-gate\nseccomp.json\nreceipt.json\n",
      "etc/vmcp/live-gate/seccomp.json": "{}\n",
    },
    "loaded_profiles": {"vmcp-live-gate": "enforce"},
  },
  // An older vmcp version runs: it holds no lock, but its enforcer watches
  // the parent cgroup with inotify. Install and teardown refuse.
  "old_service": {
    "cgroups": [{"path": "vmcp-live-gate", "owner": "live-gate"}],
    "watchers": [{"pid": 4242, "comm": "vmcp", "cgroup": "vmcp-live-gate"}],
    "files": {
      "etc/apparmor.d/vmcp-live-gate": "# vmcp-owner: live-gate\nprofile vmcp-live-gate {}\n",
      "etc/vmcp/live-gate/.vmcp-owner": "# vmcp-owner: live-gate\nseccomp.json\n",
      "etc/vmcp/live-gate/seccomp.json": "{}\n",
    },
    "loaded_profiles": {"vmcp-live-gate": "enforce"},
  },
  // The host command cannot see the host processes, so it cannot prove
  // that no service runs. Every command refuses.
  "no_host_processes": {
    "cgroups": [{"path": "vmcp-live-gate", "owner": "live-gate"}],
    "no_host_processes": true,
    "files": {"etc/apparmor.d/vmcp-live-gate": "# vmcp-owner: live-gate\nprofile vmcp-live-gate {}\n"},
    "loaded_profiles": {"vmcp-live-gate": "enforce"},
  },
  // fdinfo of inotify file descriptors, as the kernel prints them. ino and
  // sdev are hex; sdev is the kernel device number.
  "inotify": [
    {
      "name": "two watches",
      "fdinfo": "pos:\t0\nflags:\t02004000\nmnt_id:\t19\nino:\t77\ninotify wd:2 ino:1c7532 sdev:20 mask:b00 ignored_mask:0 fhandle-bytes:8 fhandle-type:fe f_handle:3275c70000000000\ninotify wd:1 ino:1 sdev:20 mask:300 ignored_mask:0 fhandle-bytes:8 fhandle-type:fe f_handle:0100000000000000\n",
      "want": [{"ino": 1865010, "dev": 32}, {"ino": 1, "dev": 32}],
    },
    {"name": "no watch", "fdinfo": "pos:\t0\nflags:\t00\nmnt_id:\t19\nino:\t77\n", "want": null},
  ],
  // A text ruleset as nft list ruleset prints it. Only the line with one
  // tab of indent in a table block is the table comment.
  "nft_ruleset": {
    "ruleset": "table inet vmcp {\n\tcomment \"vmcp:live-gate\"\n\tset guest_allow {\n\t\ttype ifname . ipv4_addr\n\t\tcomment \"vmcp guest broker access\"\n\t}\n\n\tchain input {\n\t\tiifname \"vmcp-*\" drop comment \"x\"\n\t}\n}\ntable ip filter {\n\tchain forward {\n\t\tcounter comment \"vmcp:live-gate\"\n\t}\n}\ntable inet vmcp-old {\n\tcomment \"vmcp:live-gate\"\n}\n",
    "want": [
      {"family": "inet", "name": "vmcp", "comment": "vmcp:live-gate"},
      {"family": "ip", "name": "filter", "comment": ""},
      {"family": "inet", "name": "vmcp-old", "comment": "vmcp:live-gate"},
    ],
  },
  // A file that the marker of an owned directory does not name. Teardown
  // refuses the directory and leaves it as it is.
  "untagged_config_file": {
    "files": {
      "etc/vmcp/live-gate/.vmcp-owner": "# vmcp-owner: live-gate\nseccomp.json\n",
      "etc/vmcp/live-gate/seccomp.json": "{}\n",
      "etc/vmcp/live-gate/operator-notes.txt": "keep\n",
    },
    "want_conflicts": ["config-file /etc/vmcp/live-gate/operator-notes.txt"],
  },
  // Untagged resources with the names that the install writes. Install
  // refuses and writes nothing.
  "blocked_install": {
    "cgroups": [{"path": "vmcp-live-gate"}],
    "files": {
      "etc/apparmor.d/vmcp-live-gate": "profile vmcp-live-gate {}\n",
      "etc/tmpfiles.d/vmcp-live-gate.conf": "d /sys/fs/cgroup/vmcp-live-gate 0755 root root - -\n",
    },
    "loaded_profiles": {"vmcp-live-gate": "enforce"},
    "want_conflicts": [
      "cgroup vmcp-live-gate",
      "apparmor-file /etc/apparmor.d/vmcp-live-gate",
      "apparmor-profile vmcp-live-gate",
      "tmpfiles /etc/tmpfiles.d/vmcp-live-gate.conf",
    ],
  },
  // The lines of /etc/tmpfiles.d/vmcp-live-gate.conf after an install, in
  // order. @CGROUP_ROOT@ is the cgroup root of the fake host. The
  // directory stays owned by root until its delegated files have their
  // owner; the glob line that gives it to the service user runs last.
  "want_tmpfiles": [
    "# vmcp-owner: live-gate",
    "d @CGROUP_ROOT@/vmcp-live-gate 0755 root root - -",
    "t @CGROUP_ROOT@/vmcp-live-gate - - - - trusted.vmcp.owner=live-gate",
    "w @CGROUP_ROOT@/vmcp-live-gate/cgroup.subtree_control - - - - +cpu +memory +pids",
    "z @CGROUP_ROOT@/vmcp-live-gate/cgroup.procs - 65532 65532 - -",
    "z @CGROUP_ROOT@/vmcp-live-gate/cgroup.subtree_control - 65532 65532 - -",
    "z @CGROUP_ROOT@/vmcp-live-gate/cgroup.threads - 65532 65532 - -",
    "z @CGROUP_ROOT@/[v]mcp-live-gate - 65532 65532 - -",
  ],
  // Cgroup roots that a tmpfiles.d line cannot hold as they are: install
  // refuses to write the boot file.
  "unsafe_cgroup_roots": ["/sys/fs/cgroup x", "/sys/fs/%h", "/sys/fs/cgroup*", "sys/fs/cgroup", "/sys/fs/cgroup\\x20"],
  // The log of a host install: each line by message, with its level and
  // code.
  "install_log": [
    {"msg": "host command started", "level": "INFO"},
    {"msg": "host resource written", "level": "INFO"},
    {"msg": "span", "level": "DEBUG", "span": "host.write.cgroup"},
    {"msg": "span", "level": "DEBUG", "span": "host.write.tmpfiles"},
    {"msg": "span", "level": "DEBUG", "span": "host.verify"},
    {"msg": "host command finished", "level": "INFO"},
  ],
  "blocked_log": [
    {"msg": "host conflict", "level": "WARN", "code": "host_conflict"},
    {"msg": "host command failed", "level": "ERROR", "code": "host_install_failed"},
  ],
}
