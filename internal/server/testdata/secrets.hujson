{
  // Secret entries that the fake guest prints in small chunks. Each value
  // must reach no event and no stored record.
  "secret_env": ["API_TOKEN=tok-0123456789abcdef", "DB_PASSWORD=pw-fedcba9876543210"],
  "want_record_names": ["API_TOKEN", "DB_PASSWORD"],
  "chunk_bytes": 3,
  // A secret file must be under /run, a guest tmpfs.
  "rejected_secret_file": "/etc/secret.txt",
}
